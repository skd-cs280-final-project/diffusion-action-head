{
  "protocol_version": 2,
  "scope": "pretrained_diffusion_policy_inference",
  "training_allowed": false,
  "weight_updates_allowed": false,
  "diffusion": {
    "sampler": "DDPM",
    "num_train_timesteps": 100,
    "num_inference_steps": 10,
    "sweep_allowed": false
  },
  "inputs": {
    "views": [
      "front",
      "down"
    ],
    "history_length": 0,
    "future_observations": false
  },
  "execution": {
    "action_horizon": 1,
    "execution_horizon": 1,
    "legacy_controller_unchanged": true
  },
  "checkpoints": {
    "registry": "models.json",
    "include_joint_trained_models": true,
    "offline_coverage": "all_registered_models",
    "formal_closed_loop_coverage": "predeclared_core_models",
    "smoke_models_are_performance_baselines": false
  },
  "action_order": [
    "fwd",
    "down",
    "yaw",
    "land"
  ],
  "evaluation": {
    "data_json": "data/aerovla_train_dataset.json",
    "split_json": "data/continuous_split_seed42.json",
    "offline_batch_size": 2,
    "primary_inference_seed": 42,
    "repeated_inference_seeds": [
      42,
      43,
      44
    ],
    "closed_loop_primary_seed": 100,
    "closed_loop_repeated_seeds": [
      100,
      101,
      102
    ],
    "development_manifest": null,
    "final_manifest": null,
    "manifest_status": "must_freeze_before_experiments",
    "common_closed_loop_assignment": "episode-level disjoint A/B/C shards, identical shard tasks for every core model",
    "per_member_variant_closed_loop_budget": "up to 3 frozen variant conditions on the same final task list; start with 1 and pilot timing",
    "no_independent_training_repeats": true
  }
}
